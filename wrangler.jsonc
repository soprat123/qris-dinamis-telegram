{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qris-dinamis-telegram",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/webhook/*",
      "/internal/*",
      "/api/*",
      "/health"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "BIKIN_FOTO_URL": "https://bikin-foto.merapatsoprat.workers.dev"
  }
}
